<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppThemeDayNight" parent="Theme.AppCompat.DayNight.DarkActionBar">

        <!-- Swaps inflated text widgets for crash-safe subclasses (drag-shadow bug). -->
        <item name="viewInflaterClass">com.v2ray.ang.util.SafeAppCompatViewInflater</item>

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorMainBg">@color/colorBg</item>
        <item name="colorMainText">@color/colorText</item>
        <!-- Transparent system bars so the floating glass toolbar reads on top of content -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="alertDialogTheme">@style/AppDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/AppDialogTheme</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
    </style>

    <style name="AppDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <!-- Swaps inflated text widgets for crash-safe subclasses (drag-shadow bug). -->
        <item name="viewInflaterClass">com.v2ray.ang.util.SafeAppCompatViewInflater</item>
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">95%</item>
        <item name="android:textColorPrimary">@color/colorText</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/colorWhite</item>
        <item name="android:textColorPrimary">@color/colorText</item>
    </style>
</resources>
