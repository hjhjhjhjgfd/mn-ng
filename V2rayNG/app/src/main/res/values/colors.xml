    <!-- ============================================================= -->
    <!-- ===== Glassmorphism / Material 2027 Expressive palette ===== -->
    <!-- ============================================================= -->
    <!-- Light theme tokens. All values are ARGB with alpha so the
         underlying content shows through and creates the "frosted
         glass" look. Pair with the matching night override in
         values-night/colors.xml. -->

    <!-- Hairline stroke used on every glass surface -->
    <color name="glass_stroke">#33FFFFFF</color>

    <!-- Top floating toolbar (MainActivity) -->
    <color name="glass_toolbar_solid">#CC2B2B2B</color>
    <color name="glass_secondary_toolbar_solid">#D9252525</color>

    <!-- Bottom floating toolbox -->
    <color name="glass_footer_solid">#CC2B2B2B</color>

    <!-- Connection test bar / capsule -->
    <color name="glass_capsule_solid">#B3303030</color>

    <!-- Ads / sponsor capsule - keeps the warm yellow tone but translucent -->
    <color name="glass_ads_solid">#B3FFFFB3</color>

    <!-- RecyclerView row card -->
    <color name="glass_card_solid">#E6FFFFFF</color>

    <!-- Buttons inside the bottom toolbox -->
    <color name="glass_button_solid">#99FFFFFF</color>
    <color name="glass_button_solid_pressed">#66FFFFFF</color>
    <color name="glass_button_solid_focused">#B3FFFFFF</color>

    <!-- Navigation drawer -->
    <color name="glass_drawer_solid">#F2FFFFFF</color>

    <!-- Dialogs -->
    <color name="glass_dialog_solid">#F2FFFFFF</color>

    <!-- Window scrim used behind dialogs and the nav drawer -->
    <color name="glass_scrim">#66000000</color>

    <!-- Surface tint applied behind the floating bars to fake blur on API < 31 -->
    <color name="glass_surface_tint">#0AFFFFFF</color>

