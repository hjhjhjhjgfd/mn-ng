<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_icon_blue - rounded translucent blue background for the
  license_dialog shield icon on TV. Material 2027 Expressive:
  20dp rounded corners + glass stroke.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#331E88E5" />
    <corners android:radius="@dimen/glass_corner_radius" />
    <stroke android:width="1dp" android:color="@color/glass_stroke" />
</shape>
