<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass card used by RecyclerView item rows. Replaces the old 5dp
  CardView corner with a Material 2027 18dp rounded floating card
  plus a hairline stroke and a subtle elevation hint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_card_solid" />
    <corners android:radius="@dimen/glass_corner_radius_card" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
