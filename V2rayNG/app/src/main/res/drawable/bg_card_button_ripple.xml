<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_card_button_ripple - ripple wrapper for the TV tunnel-config
  card buttons. Transparent base + ripple on touch.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/colorAccent">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/glass_corner_radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_card_solid" />
            <corners android:radius="@dimen/glass_corner_radius_card" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</ripple>
