<?xml version="1.0" encoding="utf-8"?>
<!--
  tv_focus_bg_transparent - TV focusable background that is fully
  transparent in the idle state. Provides a focus ring on the
  focused state so D-pad navigation works on the TV layout.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid_focused" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="2dp" android:color="@color/colorAccent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid_pressed" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
        </shape>
    </item>
</selector>
