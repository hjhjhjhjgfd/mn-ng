<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass button background - 14dp rounded, used for the bottom
  toolbox action buttons (get config / test / sort / sub filter).
  Stroke + translucent fill keep the buttons readable on top of
  the glass footer.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_button_solid" />
    <corners android:radius="@dimen/glass_corner_radius_button" />
    <stroke
        android:width="0.5dp"
        android:color="@color/glass_stroke" />
</shape>
