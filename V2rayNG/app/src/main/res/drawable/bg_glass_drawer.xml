<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass background for the navigation drawer surface. Translucent
  so the underlying activity shows through, with a 1dp hairline on
  the trailing edge to separate drawer from content.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_drawer_solid" />
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="@dimen/glass_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="@dimen/glass_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
