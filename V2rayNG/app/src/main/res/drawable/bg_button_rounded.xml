<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_button_rounded - rounded button background used by
  activity_dns_scanner. Material 2027 Expressive 14dp corners +
  translucent glass fill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid_pressed" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid_focused" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="2dp" android:color="@color/colorAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
