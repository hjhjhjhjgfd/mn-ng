<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_btn_blue_tv - rounded blue button background for the TV
  license dialog "agree" button. Material 2027 Expressive 14dp corners.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E88E5" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="2dp" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#421E88E5" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
