<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass background for floating dialogs (alert / fragment / bottom
  sheet). 22dp rounded corners, hairline stroke, translucent fill
  matching the Material 2027 Expressive dialog spec.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_dialog_solid" />
    <corners android:radius="@dimen/glass_corner_radius_dialog" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
