<?xml version="1.0" encoding="utf-8"?>
<!--
  Glassmorphism background used by toolbar in secondary activities
  (server, settings, routing, sub, logcat...). Slightly more opaque
  than the main toolbar so back-navigation titles stay readable on
  busy content.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_secondary_toolbar_solid" />
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="@dimen/glass_corner_radius_small"
        android:bottomRightRadius="@dimen/glass_corner_radius_small" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
