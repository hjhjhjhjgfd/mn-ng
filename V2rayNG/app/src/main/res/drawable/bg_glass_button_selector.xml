<?xml version="1.0" encoding="utf-8"?>
<!--
  Pressed state-list for glass buttons. Translucent fill darkens
  slightly when touched, giving a tactile Material 2027 response
  without breaking the glass look.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid_pressed" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="0.5dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_button_solid_focused" />
            <corners android:radius="@dimen/glass_corner_radius_button" />
            <stroke android:width="1dp" android:color="@color/colorAccent" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_glass_button" />
</selector>
