<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating glassmorphism footer for the bottom toolbox / button row.
  Rounded top corners give the floating "island" look while the bottom
  edge stays flush against the system navigation bar.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_footer_solid" />
    <corners
        android:topLeftRadius="@dimen/glass_corner_radius"
        android:topRightRadius="@dimen/glass_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
